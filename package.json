{
  "name": "pilly",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "cd apps/web && bun run dev",
    "dev:api": "cd apps/api && cargo run --bin pilly-api",
    "dev:iggy": "IGGY_SYSTEM_PATH=./.iggy-data IGGY_SYSTEM_CACHE_SIZE=64MB IGGY_TCP_ADDRESS=127.0.0.1:8090 iggy-server",
    "dev:all": "bun run dev:iggy & bun run dev:api & bun run dev:web",
    "sync:pills": "cd apps/api && cargo run --release --bin sync_pills",
    "docker:iggy": "docker compose up -d",
    "docker:api": "docker build -t pilly-api-all-in-one ./apps/api && docker run --rm -p 3001:3001 --env-file ./apps/api/.env pilly-api-all-in-one",
    "lint": "turbo run lint && (cd apps/api && cargo clippy --all-targets -- -D warnings)",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" && (cd apps/api && cargo fmt --all)",
    "ready": "bun run format && bun run lint",
    "update:deps": "bun update && (cd apps/api && cargo update)",
    "audit": "bun audit --omit=dev && (cd apps/api && cargo audit)",
    "typecheck": "turbo run typecheck",
    "test:api": "cd apps/api && cargo test",
    "test:web": "cd apps/web && bun run test",
    "test:changed": "turbo run test -- --changed",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "^2.11.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.4",
  "overrides": {
    "dompurify": ">=3.4.2",
    "next": ">=16.2.4",
    "postcss": ">=8.5.13",
    "nodemailer": ">=8.0.7",
    "vite": ">=8.0.10",
    "hono": ">=4.12.16",
    "@hono/node-server": ">=2.0.1",
    "uuid": ">=14.0.0",
    "axios": ">=1.16.0",
    "langsmith": ">=0.6.0",
    "esbuild": ">=0.28.0",
    "protobufjs": ">=8.0.3",
    "fast-xml-parser": ">=5.7.2",
    "@ai-sdk/provider-utils": ">=4.0.33",
    "@vitest/mocker": ">=4.1.12",
    "basic-ftp": ">=6.2.4",
    "minimatch": ">=11.0.1",
    "zod": ">=4.6.6"
  }
}
