{
  "name": "pilly",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "cd apps/api && cargo run --bin pilly-api",
    "dev:iggy": "IGGY_SYSTEM_PATH=./.iggy-data IGGY_SYSTEM_CACHE_SIZE=64MB IGGY_TCP_ADDRESS=127.0.0.1:8090 iggy-server",
    "lint": "turbo run lint && (cd apps/api && cargo clippy --all-targets -- -D warnings)",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" && (cd apps/api && cargo fmt --all)",
    "ready": "bun run format && bun run lint",
    "update:deps": "bun update && (cd apps/api && cargo update)",
    "audit": "bun audit && (cd apps/api && cargo audit)",
    "typecheck": "turbo run typecheck",
    "test:api": "cd apps/api && bun test --parallel",
    "test:web": "cd apps/web && bun test --parallel",
    "test:changed": "turbo run test -- --changed",
    "test": "turbo run test",
    "perf": "unlighthouse --site http://localhost:3000"
  },
  "devDependencies": {
    "@unlighthouse/cli": "^0.17.10",
    "prettier": "3.8.3",
    "turbo": "^2.11.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.12",
  "overrides": {
    "dompurify": ">=3.4.2",
    "next": ">=16.2.4",
    "postcss": ">=8.5.13",
    "nodemailer": ">=8.0.7",
    "vite": ">=8.0.10",
    "hono": ">=4.12.16",
    "@hono/node-server": ">=2.0.1",
    "uuid": ">=14.0.0",
    "axios": ">=1.16.0",
    "langsmith": ">=0.6.0",
    "esbuild": ">=0.28.0",
    "protobufjs": ">=8.0.3",
    "fast-xml-parser": ">=5.7.2"
  }
}
