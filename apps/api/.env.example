# Database (Neon 또는 로컬 PostgreSQL — DATABASE_URL 우선, 미설정 시 DB_* 조합 사용)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=pilly
DB_PASSWORD=pilly
DB_NAME=pilly
RUN_MIGRATIONS=true

# Server & CORS
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4001

# Apache Iggy
IGGY_ADDRESS=127.0.0.1:8090
IGGY_USERNAME=iggy
IGGY_PASSWORD=iggy

# Auth (Neon Auth JWKS)
NEON_AUTH_JWKS_URL=
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=

# Security (AES-256-GCM: 32 bytes / 64 hex chars)
ENCRYPTION_KEY=your_encryption_key_64_hex_chars

# Admin
ADMIN_API_KEY=your_admin_api_key

# AI (Google Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.8-flash

# External API (공공데이터포털 의약품 낱알식별정보)
DATA_GO_KR_API_KEY=your_data_go_kr_api_key
DATA_GO_KR_ENDPOINT=https://apis.data.go.kr/1471000/MdcinGrnIdntfcInfoService03/getMdcinGrnIdntfcInfoList03

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP (JIT 열람 알림 이메일 발송)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@pilly.app
